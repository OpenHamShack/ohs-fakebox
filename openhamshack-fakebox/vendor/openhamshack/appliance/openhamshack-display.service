[Unit]
Description=OpenHamShack screens (sway: receive picture and console)
After=systemd-user-sessions.service getty@tty1.service openhamshack.service
Wants=openhamshack.service
Conflicts=getty@tty1.service

[Service]
# tty1 because a logind session only goes active on the foreground VT;
# on tty7 sway waits 10 s for activation and exits. Ctrl+Alt+F2 gives a login.
# A logind session for the openhamshack user (PAMName) is what gives sway the seat
# and creates /run/user/<uid>, where openhamshack.service's mpv finds the display.
User=openhamshack
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
ExecStart=/usr/bin/sway -c /etc/openhamshack/sway.config
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
