# OpenHamShack screens. sway owns both HDMI ports because only one process can be
# DRM master of the GPU: mpv on one port and a browser on the other cannot
# each drive a connector directly. These two lines are the TV and the console
# when Settings > Display has not swapped them (that choice is openhamshack.conf's
# displayRoles, which screens.py prefers); the updater keeps them as the box
# had them. `swaymsg -s /run/user/1000/sway-ipc.*.sock -t get_outputs` lists
# the names.
set $rx HDMI-A-1
set $ui HDMI-A-2

output * bg #000000 solid_color
# Resolution, refresh, scale, rotation and Off from Settings > Display, kept
# (written by the daemon), then any change still waiting for Keep (tmpfs, so
# gone after a restart). Included rather than sent over IPC because a reload
# rebuilds sway's output settings from these files. A missing file is
# skipped without complaint by sway's include.
include /etc/openhamshack/outputs.conf
include $XDG_RUNTIME_DIR/openhamshack-outputs-trial.conf
default_border none
default_floating_border none
focus_follows_mouse no
seat * hide_cursor 3000

# Touch belongs to the settings screen, whichever port it is on. screens.py
# maps it again to whichever screen is the console once it knows (a laptop's
# panel, a swapped pair, the only screen); being mapped to the screen it is on
# is also what turns touches with a rotated screen.
input type:touch map_to_output $ui
input type:tablet_tool map_to_output $ui

workspace 1 output $rx
workspace 2 output $ui

# Chromium in --app mode reports app_id chrome-<url>-Default, not chromium.
# The daemon starts mpv (it chooses the tuner's stream). screens.py places it
# and the console for however many screens are connected - full screen each
# on two, picture-in-picture on one - and again whenever that changes.
exec_always python3 /opt/openhamshack/screens.py $rx $ui

exec chromium --ozone-platform=wayland --kiosk --no-first-run --noerrdialogs \
  --disable-session-crashed-bubble --disable-features=Translate \
  --user-data-dir=/home/openhamshack/.config/openhamshack-kiosk --app=http://127.0.0.1:8080/
